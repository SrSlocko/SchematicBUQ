#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""Lanzador de SchematicBuq.

Localiza el paquete (instalación del sistema o copia de desarrollo), se coloca
en su carpeta y arranca la aplicación. Todos los datos que el programa escribe
van al directorio del usuario (~/.local/share/schematicbuq), nunca a /usr/share.
"""
import os
import sys


def _find_pkg_dir() -> str:
    candidates = [
        "/usr/share/schematicbuq",
        os.path.join(os.path.dirname(os.path.abspath(__file__))),
        os.path.expanduser("~/.local/share/schematicbuq"),
    ]
    env = os.environ.get("SCHEMATICBUQ_DIR")
    if env:
        candidates.insert(0, env)
    for c in candidates:
        if c and os.path.isfile(os.path.join(c, "main.py")):
            return c
    return ""


def main() -> int:
    pkg_dir = _find_pkg_dir()
    if not pkg_dir:
        sys.stderr.write(
            "No se encontró el programa SchematicBuq.\n"
            "Instálalo con: sudo pacman -S schematicbuq\n")
        return 1
    sys.path.insert(0, pkg_dir)
    os.chdir(pkg_dir)
    from main import main as run
    run()
    return 0


if __name__ == "__main__":
    sys.exit(main())
